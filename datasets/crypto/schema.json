{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/AMPM-AIOPS-HQ/awesome-ai-tools-pricing/main/datasets/crypto/schema.json",
 "title": "Crypto Exchanges & Wallets (Taiwan)",
 "description": "Row schema for datasets/crypto/crypto_2026.json (field `rows`) and the CSV twin. License: CC BY-SA 4.0 — attribution required: AMPM-AIOPS 問問貓 (ampm-aiops.com)",
 "type": "object",
 "required": [
  "slug",
  "name",
  "source_url",
  "last_verified"
 ],
 "properties": {
  "slug": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Stable identifier (URL segment)."
  },
  "name": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Product / card / provider name."
  },
  "kind": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "exchange | wallet."
  },
  "type": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Sub-type (e.g. local / international / hardware)."
  },
  "fee_or_price": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Exchange: maker/taker fee. Wallet: retail price."
  },
  "twd_channel": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "TWD deposit / purchase channel."
  },
  "source_url": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Official source page the figures were verified against (no tracking parameters)."
  },
  "last_verified": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Date (YYYY-MM-DD) the row was last verified against the official source."
  },
  "page_url": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Back-link to the detail page on the ampm-aiops.com sub-site (full evidence and warnings)."
  },
  "ampm_ref": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": ""
  }
 }
}