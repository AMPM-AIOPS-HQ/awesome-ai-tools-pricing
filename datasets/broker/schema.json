{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/AMPM-AIOPS-HQ/awesome-ai-tools-pricing/main/datasets/broker/schema.json",
 "title": "US Stock Brokers for Taiwan residents",
 "description": "Row schema for datasets/broker/broker_2026.json (field `rows`) and the CSV twin. License: CC BY-SA 4.0 — attribution required: AMPM-AIOPS 問問貓 (ampm-aiops.com)",
 "type": "object",
 "required": [
  "slug",
  "name",
  "source_url",
  "last_verified"
 ],
 "properties": {
  "slug": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Stable identifier (URL segment)."
  },
  "name": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Product / card / provider name."
  },
  "tw_eligible": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Whether Taiwan residents can open an account."
  },
  "trade_fee": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Stock / ETF commission."
  },
  "min_deposit": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Minimum deposit."
  },
  "idle_fee": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Inactivity fee."
  },
  "source_url": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Official source page the figures were verified against (no tracking parameters)."
  },
  "last_verified": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Date (YYYY-MM-DD) the row was last verified against the official source."
  },
  "page_url": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": "Back-link to the detail page on the ampm-aiops.com sub-site (full evidence and warnings)."
  },
  "ampm_ref": {
   "type": [
    "string",
    "number",
    "boolean",
    "array",
    "null"
   ],
   "description": ""
  }
 }
}